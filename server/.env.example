# ---- Mafia Server Environment ----
# Server port
PORT=5000

# MongoDB connection string.
# If MongoDB is unreachable the server automatically falls back to an in-memory store.
# MONGO_URI=mongodb://127.0.0.1:27017/mafia
MONGO_URI="mongodb+srv://adeshbhongale03:Adesh07@cluster0.e4ibluq.mongodb.net/mafia?retryWrites=true&w=majority&appName=Cluster0"

# Production Jitsi domain (defaults to meet.jit.si)
JITSI_DOMAIN=meet.jit.si

# Set to 1 to wipe the database on every server start (fresh start, no old rooms restored).
# Set to 0 (or remove) to keep rooms/games between restarts.
RESET_DB=0
